---
import { withBase } from "../data/urls";
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Contact" description="Neem contact op met Bianca Ebeling van AbAut. Stel je vraag of ontdek of persoonlijke begeleiding bij autisme bij jou past.">
  <PageIntro eyebrow="Laten we kennismaken" title="Een eerste stap begint hier." description="Heb je een vraag of wil je weten of mijn begeleiding bij je past? Je bent welkom om contact op te nemen."/>
  <section class="container contact-content"><div class="email-card"><span class="mail-icon"><Icon name="mail" size={35}/></span><span class="eyebrow">Stuur me een bericht</span><h2>Hoi Bianca,</h2><p>Vertel gerust kort wat je vraag is.<br/>Dan kunnen we samen verder kijken.</p><a class="email-address" href={`mailto:${site.email}`}>{site.email}<Icon/></a><span class="email-caption">Opent je eigen e-mailprogramma</span></div><div class="contact-aside"><h2>Op jouw manier.</h2><p>Je hoeft je verhaal niet meteen helemaal helder te hebben. Een vraag is genoeg om te beginnen.</p><div class="social-list">{site.social.map(item => <a href={withBase(item.href)}>{item.label}<Icon name="external" size={22}/></a>)}</div><p class="contact-signature">Bianca Ebeling<span>AbAut · begeleiding bij autisme</span></p></div></section>
</Base>
