---
import { withBase } from "../data/urls";
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Pagina niet gevonden" noindex><PageIntro eyebrow="404 · Even de weg kwijt" title="Hier is nog niets." description="Deze pagina bestaat niet of is verplaatst. Via de homepage helpen we je weer op weg."/><div class="container not-found-actions"><a class="button" href={withBase("/")} >Naar de homepage<Icon/></a><a class="text-link" href={withBase("/contact/")} >Contact opnemen<Icon/></a></div></Base>
